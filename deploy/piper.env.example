# Copy this file to /etc/piper/piper.env, fill in real values, and lock
# down its permissions:
#
#   sudo install -d /etc/piper
#   sudo install -m 600 deploy/piper.env.example /etc/piper/piper.env
#   sudo $EDITOR /etc/piper/piper.env
#
# systemd's EnvironmentFile= loads this directly, so the token never
# appears in `ps` output, shell history, or a systemd unit file checked
# into version control.

# Long random shared secret required as ?token= on the phone-facing
# /ws, /ws/control, and /api/sessions. Generate one with:
#   openssl rand -hex 32
PIPER_TOKEN=replace-with-a-long-random-value

# Loopback only: `tailscale serve` is what exposes this to your tailnet.
PIPER_BIND=127.0.0.1:4390

# The agent token (gates /agent, where `piper-agent` extensions
# register live sessions - see SPEC.md §7) does NOT need to be set
# here: Piper generates one automatically on first run and persists it
# to ~/.pi/agent/piper/agent-token (mode 0600), which `piper-agent`
# reads directly. Only set PIPER_AGENT_TOKEN explicitly if you have a
# specific reason to pin it to a fixed value.
# PIPER_AGENT_TOKEN=

# Optional: also spawn a headless `pi --mode rpc` for one project with
# no terminal open (Piper v1 behavior, see SPEC.md §10). Most setups
# don't need this - `/rc` inside a normal interactive `pi` session is
# the primary way to connect a project.
# PIPER_PROJECT_DIR=/home/YOUR_USER/path/to/project

# Uncomment to resume a specific session file for the headless project
# instead of starting a new one each time Piper restarts. Only used
# together with PIPER_PROJECT_DIR.
# PIPER_SESSION=/home/YOUR_USER/.pi/agent/sessions/.../some-session.jsonl

# Uncomment to run the headless project in ephemeral mode instead
# (mutually exclusive with PIPER_SESSION).
# PIPER_NO_SESSION=true
