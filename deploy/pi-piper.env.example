# Copy this file to /etc/pi-piper/pi-piper.env, fill in real values, and lock
# down its permissions:
#
#   sudo install -d /etc/pi-piper
#   sudo install -m 600 deploy/pi-piper.env.example /etc/pi-piper/pi-piper.env
#   sudo $EDITOR /etc/pi-piper/pi-piper.env
#
# systemd's EnvironmentFile= loads this directly, so secrets never
# appear in `ps` output, shell history, or a systemd unit file checked
# into version control.

# Loopback only: `tailscale serve` is what exposes this to your tailnet.
# Any device signed into your tailnet is authorized to reach /ws,
# /ws/control, and /api/sessions once it's exposed this way - see
# ARCHITECTURE.md. Do not use `tailscale funnel` (public internet) in front
# of this.
PI_PIPER_BIND=127.0.0.1:4390

# The agent token (gates /agent, where `pi-piper-agent` extensions
# register live sessions) does NOT need to be set
# here: Pi Piper generates one automatically on first run and persists it
# to ~/.pi/agent/pi-piper/agent-token (mode 0600), which `pi-piper-agent`
# reads directly. Only set PI_PIPER_AGENT_TOKEN explicitly if you have a
# specific reason to pin it to a fixed value.
# PI_PIPER_AGENT_TOKEN=

# Optional: also spawn a headless `pi --mode rpc` for one project with
# no terminal open (Pi Piper v1 behavior). Most setups
# don't need this - `/rc` inside a normal interactive `pi` session is
# the primary way to connect a project.
# PI_PIPER_PROJECT_DIR=/home/YOUR_USER/path/to/project

# Uncomment to resume a specific session file for the headless project
# instead of starting a new one each time Pi Piper restarts. Only used
# together with PI_PIPER_PROJECT_DIR.
# PI_PIPER_SESSION=/home/YOUR_USER/.pi/agent/sessions/.../some-session.jsonl

# Uncomment to run the headless project in ephemeral mode instead
# (mutually exclusive with PI_PIPER_SESSION).
# PI_PIPER_NO_SESSION=true
