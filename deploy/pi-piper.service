[Unit]
Description=Pi Piper Hub - multi-session remote control for pi coding-agent sessions
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Run as the same user who runs `pi` interactively and whose
# ~/.pi/agent/pi-piper/agent-token pi-piper-agent extensions will read. This
# is also the user with an authenticated `pi`
# (credentials live under ~/.pi/agent/auth.json) if PI_PIPER_PROJECT_DIR
# is used for an optional headless session.
User=YOUR_USER

# See deploy/pi-piper.env.example. Keep this file's permissions restrictive
# (chmod 600) in case PI_PIPER_AGENT_TOKEN is pinned here.
EnvironmentFile=/etc/pi-piper/pi-piper.env

ExecStart=/usr/local/bin/pi-piper

Restart=on-failure
RestartSec=2

# Light sandboxing. Not full ProtectSystem=strict confinement, since `pi`
# needs ordinary read/write access to the target project directory and to
# its own config under the service user's home directory.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
